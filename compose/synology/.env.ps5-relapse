# IPv4 address of the machine that will serve the exploit host.
# Point your PS5 (and optionally your router's DHCP DNS) at this address.
SERVER_IP=xxx.xxx.xxx.xxx

# Optional: upstream resolvers used by dnsmasq for everything else
UPSTREAM_DNS_1=1.1.1.1
UPSTREAM_DNS_2=8.8.8.8

# Upstream host page (WAK1360 UI). Pin the commit the overlay was built for.
HOST_REPO=https://github.com/arg0WAK/WAK1360-Relapse.git
HOST_REF=b2398fd5bea116f990595e0a187ae94d8c6db43d

# Optional FTP payload (scripts/add-ftpsrv.sh)
FTPSRV_VERSION=v0.21.1
FTPSRV_URL=https://github.com/ps5-payload-dev/ftpsrv/releases/download/v0.21.1/ftpsrv-ps5.elf
FTPSRV_SHA256=7d4b31c83eae4e056580482a3a074e1db25922efc74ac1e439473b45d71a5938
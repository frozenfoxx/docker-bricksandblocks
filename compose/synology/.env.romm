###############################################################################
# RomM settings                                                               #
###############################################################################

# Database (Postgres)
ROMM_DB_USER=romm-user
ROMM_DB_PASSWORD=

# Generate with: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=

# Metadata providers (optional; only used when scanning/refreshing metadata)
#ROMM_HASHEOUS_API_ENABLED=true
#ROMM_IGDB_CLIENT_ID=
#ROMM_IGDB_CLIENT_SECRET=
#ROMM_RETROACHIEVEMENTS_API_KEY=
#ROMM_SCREENSCRAPER_USER=
#ROMM_SCREENSCRAPER_PASSWORD=
#ROMM_STEAMGRIDDB_API_KEY=

# OIDC (Authentik application slug 'romm')
# Authentik 2025.10+ needs a scope mapping that returns email_verified=True,
# or RomM logins fail silently.
#ROMM_OIDC_ENABLED=true
#ROMM_OIDC_CLIENT_ID=
#ROMM_OIDC_CLIENT_SECRET=

# Optional group-to-role mapping. Once ROMM_OIDC_CLAIM_ROLES is set, users who
# match none of the groups below are refused at login.
#ROMM_OIDC_CLAIM_ROLES=groups
#ROMM_OIDC_ROLE_ADMIN=
#ROMM_OIDC_ROLE_VIEWER=

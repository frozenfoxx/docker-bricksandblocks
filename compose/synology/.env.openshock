###############################################################################
# OpenShock settings                                                          #
#                                                                             #
# See https://wiki.openshock.org/hosting/ for all available options.          #
###############################################################################

# Domain the WebUI is served on. The API and Live Control Gateway are served
# from subdomains of it (api.<domain> and gateway.<domain> by default), so
# whatever routes here needs those names too.
OPENSHOCK_DOMAIN=openshock.bricksandblocks.net
#OPENSHOCK_API_SUBDOMAIN=api
#OPENSHOCK_GATEWAY_SUBDOMAIN=gateway

# Name shown in the WebUI.
#OPENSHOCK_NAME=OpenShock

# ISO country code the Live Control Gateway reports itself as serving.
#OPENSHOCK_LCG_COUNTRYCODE=US

# Cloudflare Turnstile captcha on signup/login. Leave disabled unless the
# corresponding site/secret keys are also configured.
#OPENSHOCK_TURNSTILE_ENABLE=false

# Database credentials. The password is required; the API, gateway and cron
# services all build their connection string from these.
OPENSHOCK_PG_DB=openshock
OPENSHOCK_PG_USER=openshock
OPENSHOCK_PG_PASS=
